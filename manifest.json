{
  "manifest_version": 3,
  "name": "git-blame-ai",
  "version": "1.0.0",
  "description": "Separate human contributors from autonomous Bot & AI Agent accounts in GitHub Contributions.",
  "permissions": ["storage", "activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "git-blame-ai",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "css": ["styles/content.css"],
      "js": [
        "src/known-bots.js",
        "src/detector.js",
        "src/storage.js",
        "src/ui.js",
        "src/views/contributors-graph.js",
        "src/views/repo-sidebar.js",
        "src/views/commits-list.js",
        "src/views/issues-prs.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
